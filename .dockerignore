# Keep the build context small and free of anything sensitive. The
# Dockerfile copies the whole context (COPY . .), so anything secret
# must be listed here.

.git
node_modules
**/node_modules

# Never ship signing keys or local secrets into the build context
.devcontainer/secrets/

.env
.env.*
!.env.example

**/dist
data
build
coverage
*.log
.DS_Store
test-results
.superpowers
