{
  "name": "@gubbins/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src",
    "test": "vitest run --dir src",
    "migrate": "tsx src/infrastructure/db/migrate.ts",
    "dev": "tsx watch src/presentation/server.ts",
    "gen:openapi": "tsx scripts/emit-openapi.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^10.0.1",
    "@fastify/static": "^10.1.5",
    "@fastify/swagger": "^9.9.0",
    "@gubbins/shared-types": "*",
    "better-sqlite3": "^11.3.0",
    "fastify": "^5.0.0",
    "fastify-type-provider-zod": "^7.0.0",
    "kysely": "^0.29.6",
    "uuid": "^14.0.2",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^24.19.0",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "eslint": "^10.11.0",
    "tsx": "^4.19.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.2"
  }
}
