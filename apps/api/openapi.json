{
  "openapi": "3.0.3",
  "info": {
    "title": "gubbins",
    "version": "0.0.0"
  },
  "components": {
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          },
          "code": {
            "type": "string",
            "enum": [
              "item_unavailable",
              "hold_not_active",
              "hold_already_extended"
            ]
          },
          "issues": {
            "type": "array",
            "items": {}
          }
        },
        "required": [
          "message"
        ],
        "additionalProperties": false
      }
    }
  },
  "paths": {
    "/api/lists": {
      "post": {
        "operationId": "createList",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "listTitle": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  },
                  "itemTitle": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  }
                },
                "required": [
                  "listTitle",
                  "itemTitle"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The list was created.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "slug": {
                      "type": "string"
                    },
                    "ownerToken": {
                      "type": "string"
                    },
                    "key": {
                      "type": "string"
                    },
                    "itemId": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "slug",
                    "ownerToken",
                    "key",
                    "itemId"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "The request did not match the schema.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/lists/{slug}/session": {
      "post": {
        "operationId": "enterGuestKey",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "key": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "key"
                ]
              }
            }
          }
        },
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "in": "path",
            "name": "slug",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "The key was accepted and a session cookie was set.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean",
                      "enum": [
                        true
                      ]
                    }
                  },
                  "required": [
                    "ok"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "The request did not match the schema.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "No such list, or the key is wrong. The two are deliberately indistinguishable (ADR-016, ADR-054).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/lists/{slug}": {
      "get": {
        "operationId": "getListView",
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "in": "path",
            "name": "slug",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "The list and its item.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "title": {
                      "type": "string"
                    },
                    "item": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "title": {
                          "type": "string"
                        },
                        "status": {
                          "type": "string",
                          "enum": [
                            "available",
                            "held",
                            "purchased"
                          ]
                        }
                      },
                      "required": [
                        "id",
                        "title",
                        "status"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "title",
                    "item"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "404": {
            "description": "No such list, or no valid session for it. The two are deliberately indistinguishable (ADR-016, ADR-054).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/lists/{slug}/items/{itemId}/hold": {
      "post": {
        "operationId": "holdItem",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "idempotencyKey": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "idempotencyKey"
                ]
              }
            }
          }
        },
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "in": "path",
            "name": "slug",
            "required": true
          },
          {
            "schema": {
              "type": "string"
            },
            "in": "path",
            "name": "itemId",
            "required": true
          }
        ],
        "responses": {
          "201": {
            "description": "The item is now held for this session.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "holdId": {
                      "type": "string"
                    },
                    "itemId": {
                      "type": "string"
                    },
                    "expiresAt": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "holdId",
                    "itemId",
                    "expiresAt"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "The request did not match the schema.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "No such list or item, or no valid session for the list. These are deliberately indistinguishable (ADR-016, ADR-054).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "No unit of the item is free (item_unavailable), or a concurrent change won (no code).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  }
}
