{
  "openapi": "3.0.3",
  "info": {
    "title": "gubbins",
    "version": "0.0.0"
  },
  "components": {
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          },
          "code": {
            "type": "string",
            "enum": [
              "item_unavailable",
              "hold_not_active",
              "hold_already_extended",
              "no_payment_method",
              "amount_out_of_range"
            ]
          },
          "issues": {
            "type": "array",
            "items": {}
          }
        },
        "required": [
          "message"
        ],
        "additionalProperties": false
      }
    }
  },
  "paths": {
    "/api/lists": {
      "post": {
        "operationId": "createList",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "listTitle": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  },
                  "itemTitle": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  },
                  "createSecret": {
                    "type": "string"
                  },
                  "venmoHandle": {
                    "type": "string",
                    "maxLength": 254
                  },
                  "zelleHandle": {
                    "type": "string",
                    "maxLength": 254
                  }
                },
                "required": [
                  "listTitle",
                  "itemTitle"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The list was created.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "slug": {
                      "type": "string"
                    },
                    "ownerToken": {
                      "type": "string"
                    },
                    "key": {
                      "type": "string"
                    },
                    "itemId": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "slug",
                    "ownerToken",
                    "key",
                    "itemId"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "The request did not match the schema, or a domain rule refused it.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "The create secret was missing or wrong (ADR-0080).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/lists/{slug}/session": {
      "post": {
        "operationId": "enterGuestKey",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "key": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "key"
                ]
              }
            }
          }
        },
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "in": "path",
            "name": "slug",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "The key was accepted and a session cookie was set.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean",
                      "enum": [
                        true
                      ]
                    }
                  },
                  "required": [
                    "ok"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "The request did not match the schema, or a domain rule refused it.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "No such list, or the key is wrong. The two are deliberately indistinguishable (ADR-0016, ADR-0054).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/lists/{slug}/owner-session": {
      "post": {
        "operationId": "enterOwnerToken",
