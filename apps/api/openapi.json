                    "holdId": {
                      "type": "string"
                    },
                    "itemId": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "active",
                        "expired",
                        "released",
                        "purchased"
                      ]
                    },
                    "expiresAt": {
                      "type": "string"
                    },
                    "extendedAt": {
                      "nullable": true,
                      "type": "string"
                    },
                    "actions": {
                      "type": "object",
                      "properties": {
                        "extend": {
                          "type": "boolean"
                        },
                        "release": {
                          "type": "boolean"
