            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean",
                      "enum": [
                        true
                      ]
                    }
                  },
                  "required": [
                    "ok"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "The request did not match the schema, or a domain rule refused it.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "No such list, or the token is wrong. Deliberately indistinguishable (ADR-0016, ADR-0054).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/lists/{slug}": {
      "get": {
        "operationId": "getListView",
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "in": "path",
            "name": "slug",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "The list, its item, this session's holds, and what this server does for guests.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "title": {
                      "type": "string"
                    },
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "title": {
                            "type": "string"
                          },
                          "type": {
                            "type": "string",
                            "enum": [
                              "single",
                              "group"
                            ]
                          },
                          "status": {
                            "type": "string",
                            "enum": [
                              "available",
                              "held",
                              "purchased"
                            ]
                          },
                          "availableUnits": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                          },
                          "url": {
                            "nullable": true,
                            "type": "string"
                          },
                          "priceMinor": {
                            "nullable": true,
                            "type": "integer",
                            "minimum": -9007199254740991,
                            "maximum": 9007199254740991
                          },
                          "pledgedMinor": {
                            "nullable": true,
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                          }
                        },
                        "required": [
                          "id",
                          "title",
                          "type",
                          "status",
                          "availableUnits",
                          "url",
                          "priceMinor",
                          "pledgedMinor"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "payment": {
                      "type": "object",
                      "properties": {
                        "venmoHandle": {
                          "nullable": true,
                          "type": "string"
                        },
                        "zelleHandle": {
                          "nullable": true,
                          "type": "string"
                        }
                      },
                      "required": [
                        "venmoHandle",
                        "zelleHandle"
                      ],
                      "additionalProperties": false
                    },
                    "myHolds": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "holdId": {
                            "type": "string"
                          },
                          "itemId": {
                            "type": "string"
                          },
                          "status": {
                            "type": "string",
                            "enum": [
                              "active",
                              "expired",
                              "released",
                              "purchased"
                            ]
                          },
                          "expiresAt": {
                            "type": "string"
                          },
                          "extendedAt": {
                            "nullable": true,
                            "type": "string"
                          },
                          "actions": {
                            "type": "object",
                            "properties": {
                              "extend": {
                                "type": "boolean"
                              },
                              "release": {
                                "type": "boolean"
                              },
                              "purchase": {
                                "type": "boolean"
                              }
                            },
                            "required": [
                              "extend",
                              "release",
                              "purchase"
                            ],
                            "additionalProperties": false
                          }
                        },
                        "required": [
                          "holdId",
                          "itemId",
                          "status",
                          "expiresAt",
                          "extendedAt",
                          "actions"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "capabilities": {
                      "type": "object",
                      "properties": {
                        "holdDurationDays": {
                          "type": "integer",
                          "minimum": 0,
                          "exclusiveMinimum": true,
                          "maximum": 9007199254740991
                        }
                      },
                      "required": [
                        "holdDurationDays"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "title",
                    "items",
                    "payment",
                    "myHolds",
                    "capabilities"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "The request did not match the schema, or a domain rule refused it.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "No such list, or no valid session for it. The two are deliberately indistinguishable (ADR-0016, ADR-0054).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/lists/{slug}/items": {
      "post": {
        "operationId": "addItem",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "enum": [
                          "single"
                        ]
                      },
                      "title": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 120
                      },
                      "quantity": {
                        "default": 1,
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 99
                      },
                      "url": {
                        "type": "string",
                        "maxLength": 2048,
                        "format": "uri"
                      },
                      "priceMinor": {
                        "type": "integer",
                        "minimum": 0,
                        "exclusiveMinimum": true,
                        "maximum": 1000000000000
                      }
                    },
                    "required": [
                      "type",
                      "title"
                    ]
                  },
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "enum": [
                          "group"
                        ]
                      },
                      "title": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 120
                      },
                      "url": {
                        "type": "string",
                        "maxLength": 2048,
                        "format": "uri"
                      },
                      "priceMinor": {
                        "type": "integer",
                        "minimum": 0,
                        "exclusiveMinimum": true,
                        "maximum": 1000000000000
                      }
                    },
                    "required": [
                      "type",
                      "title",
                      "priceMinor"
                    ]
                  }
                ]
              }
            }
          }
        },
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "in": "path",
            "name": "slug",
            "required": true
          }
        ],
        "responses": {
          "201": {
            "description": "The item was added to the list.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "itemId": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "itemId"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "The request did not match the schema, or a domain rule refused it.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "No such list, or no owner cookie for it. Deliberately indistinguishable (ADR-0016, ADR-0054).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "A group gift needs a payment method on the list (no_payment_method).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/lists/{slug}/items/{itemId}/hold": {
      "post": {
        "operationId": "holdItem",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "idempotencyKey": {
                    "type": "string",
                    "minLength": 1
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "message": {
                    "type": "string",
                    "maxLength": 300
                  }
                },
                "required": [
                  "idempotencyKey",
                  "name"
                ]
              }
            }
          }
        },
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "in": "path",
            "name": "slug",
            "required": true
          },
          {
            "schema": {
              "type": "string"
            },
            "in": "path",
            "name": "itemId",
            "required": true
          }
        ],
        "responses": {
          "201": {
            "description": "The item is now held for this session; a replayed idempotency key returns the same hold.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "holdId": {
                      "type": "string"
                    },
                    "itemId": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "active",
                        "expired",
                        "released",
                        "purchased"
                      ]
                    },
                    "expiresAt": {
                      "type": "string"
                    },
                    "extendedAt": {
                      "nullable": true,
                      "type": "string"
                    },
                    "actions": {
                      "type": "object",
                      "properties": {
                        "extend": {
                          "type": "boolean"
                        },
                        "release": {
                          "type": "boolean"
                        },
                        "purchase": {
                          "type": "boolean"
                        }
                      },
                      "required": [
                        "extend",
                        "release",
                        "purchase"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "holdId",
                    "itemId",
                    "status",
                    "expiresAt",
                    "extendedAt",
                    "actions"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "The request did not match the schema, or a domain rule refused it.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "No such list or item, or no valid session for the list. These are deliberately indistinguishable (ADR-0016, ADR-0054).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "No unit of the item is free (item_unavailable), or a concurrent change won (no code).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/lists/{slug}/items/{itemId}/contributions": {
      "post": {
        "operationId": "pledgeContribution",
