{
  "openapi": "3.0.3",
  "info": {
    "title": "gubbins",
    "version": "0.0.0"
  },
  "components": {
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          },
          "code": {
            "type": "string",
            "enum": [
              "item_unavailable",
              "hold_not_active",
              "hold_already_extended"
            ]
          },
          "issues": {
            "type": "array",
            "items": {}
          }
        },
        "required": [
          "message"
        ],
        "additionalProperties": false
      }
    }
  },
  "paths": {
    "/api/lists": {
      "post": {
        "operationId": "createList",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "listTitle": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  },
                  "itemTitle": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  },
                  "createSecret": {
                    "type": "string"
                  }
                },
                "required": [
                  "listTitle",
                  "itemTitle"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The list was created.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "slug": {
                      "type": "string"
                    },
                    "ownerToken": {
                      "type": "string"
                    },
                    "key": {
                      "type": "string"
                    },
                    "itemId": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "slug",
                    "ownerToken",
                    "key",
                    "itemId"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "The request did not match the schema.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "The create secret was missing or wrong (ADR-0080).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/lists/{slug}/session": {
      "post": {
        "operationId": "enterGuestKey",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "key": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "key"
                ]
              }
            }
          }
        },
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "in": "path",
            "name": "slug",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "The key was accepted and a session cookie was set.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean",
                      "enum": [
                        true
                      ]
                    }
                  },
                  "required": [
                    "ok"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "The request did not match the schema.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "No such list, or the key is wrong. The two are deliberately indistinguishable (ADR-0016, ADR-0054).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/lists/{slug}/owner-session": {
      "post": {
        "operationId": "enterOwnerToken",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "ownerToken": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "ownerToken"
                ]
              }
            }
          }
        },
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "in": "path",
            "name": "slug",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "The token was accepted and an owner cookie was set.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean",
                      "enum": [
                        true
                      ]
                    }
                  },
                  "required": [
                    "ok"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "The request did not match the schema.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "No such list, or the token is wrong. Deliberately indistinguishable (ADR-0016, ADR-0054).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/lists/{slug}": {
      "get": {
        "operationId": "getListView",
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "in": "path",
            "name": "slug",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "The list, its item, this session's holds, and what this server does for guests.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "title": {
                      "type": "string"
                    },
                    "item": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "title": {
                          "type": "string"
                        },
                        "status": {
                          "type": "string",
                          "enum": [
                            "available",
                            "held",
                            "purchased"
                          ]
                        }
                      },
                      "required": [
                        "id",
                        "title",
                        "status"
                      ],
                      "additionalProperties": false
                    },
                    "myHolds": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "holdId": {
                            "type": "string"
                          },
                          "itemId": {
                            "type": "string"
                          },
                          "status": {
                            "type": "string",
                            "enum": [
                              "active",
                              "expired",
                              "released",
                              "purchased"
                            ]
                          },
                          "expiresAt": {
                            "type": "string"
                          },
                          "extendedAt": {
                            "nullable": true,
                            "type": "string"
                          },
                          "actions": {
                            "type": "object",
                            "properties": {
                              "extend": {
                                "type": "boolean"
                              },
                              "release": {
                                "type": "boolean"
                              },
                              "purchase": {
                                "type": "boolean"
                              }
                            },
                            "required": [
                              "extend",
                              "release",
                              "purchase"
                            ],
                            "additionalProperties": false
                          }
                        },
                        "required": [
                          "holdId",
                          "itemId",
                          "status",
                          "expiresAt",
                          "extendedAt",
                          "actions"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "capabilities": {
                      "type": "object",
                      "properties": {
                        "holdDurationDays": {
                          "type": "integer",
                          "minimum": 0,
                          "exclusiveMinimum": true,
                          "maximum": 9007199254740991
                        }
                      },
                      "required": [
                        "holdDurationDays"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "title",
                    "item",
                    "myHolds",
                    "capabilities"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "404": {
            "description": "No such list, or no valid session for it. The two are deliberately indistinguishable (ADR-0016, ADR-0054).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/lists/{slug}/items/{itemId}/hold": {
      "post": {
        "operationId": "holdItem",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "idempotencyKey": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "idempotencyKey"
                ]
              }
            }
          }
        },
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "in": "path",
            "name": "slug",
            "required": true
          },
          {
            "schema": {
              "type": "string"
            },
            "in": "path",
            "name": "itemId",
            "required": true
          }
        ],
        "responses": {
          "201": {
            "description": "The item is now held for this session; a replayed idempotency key returns the same hold.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "holdId": {
                      "type": "string"
                    },
                    "itemId": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "active",
                        "expired",
                        "released",
                        "purchased"
                      ]
                    },
                    "expiresAt": {
                      "type": "string"
                    },
                    "extendedAt": {
                      "nullable": true,
                      "type": "string"
                    },
                    "actions": {
                      "type": "object",
                      "properties": {
                        "extend": {
                          "type": "boolean"
                        },
                        "release": {
                          "type": "boolean"
                        },
                        "purchase": {
                          "type": "boolean"
                        }
                      },
                      "required": [
                        "extend",
                        "release",
                        "purchase"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "holdId",
                    "itemId",
                    "status",
                    "expiresAt",
                    "extendedAt",
                    "actions"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "The request did not match the schema.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "No such list or item, or no valid session for the list. These are deliberately indistinguishable (ADR-0016, ADR-0054).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "No unit of the item is free (item_unavailable), or a concurrent change won (no code).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/lists/{slug}/holds/{holdId}/extend": {
      "post": {
        "operationId": "extendHold",
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "in": "path",
            "name": "slug",
            "required": true
          },
          {
            "schema": {
              "type": "string"
            },
            "in": "path",
            "name": "holdId",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "The hold was extended once, by the configured duration, from its current expiry.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "holdId": {
                      "type": "string"
                    },
                    "itemId": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "active",
                        "expired",
                        "released",
                        "purchased"
                      ]
                    },
                    "expiresAt": {
                      "type": "string"
                    },
                    "extendedAt": {
                      "nullable": true,
                      "type": "string"
                    },
                    "actions": {
                      "type": "object",
                      "properties": {
                        "extend": {
                          "type": "boolean"
                        },
                        "release": {
                          "type": "boolean"
                        },
                        "purchase": {
                          "type": "boolean"
                        }
                      },
                      "required": [
                        "extend",
                        "release",
                        "purchase"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "holdId",
                    "itemId",
                    "status",
                    "expiresAt",
                    "extendedAt",
                    "actions"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "404": {
            "description": "No such list or hold, no valid session for the list, or the hold is not this session's. These are deliberately indistinguishable (ADR-0016, ADR-0054).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "The hold is not active (hold_not_active) or was already extended (hold_already_extended).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/lists/{slug}/holds/{holdId}/release": {
      "post": {
        "operationId": "releaseHold",
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "in": "path",
            "name": "slug",
            "required": true
          },
          {
            "schema": {
              "type": "string"
            },
            "in": "path",
            "name": "holdId",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "The hold was released; its unit is free for others.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "holdId": {
                      "type": "string"
                    },
                    "itemId": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "active",
                        "expired",
                        "released",
                        "purchased"
                      ]
                    },
                    "expiresAt": {
                      "type": "string"
                    },
                    "extendedAt": {
                      "nullable": true,
                      "type": "string"
                    },
                    "actions": {
                      "type": "object",
                      "properties": {
                        "extend": {
                          "type": "boolean"
                        },
                        "release": {
                          "type": "boolean"
                        },
                        "purchase": {
                          "type": "boolean"
                        }
                      },
                      "required": [
                        "extend",
                        "release",
                        "purchase"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "holdId",
                    "itemId",
                    "status",
                    "expiresAt",
                    "extendedAt",
                    "actions"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "404": {
            "description": "No such list or hold, no valid session for the list, or the hold is not this session's. These are deliberately indistinguishable (ADR-0016, ADR-0054).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "The hold is not active (hold_not_active).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/lists/{slug}/holds/{holdId}/purchase": {
      "post": {
        "operationId": "markHoldPurchased",
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "in": "path",
            "name": "slug",
            "required": true
          },
          {
            "schema": {
              "type": "string"
            },
            "in": "path",
            "name": "holdId",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "The hold was marked purchased.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "holdId": {
                      "type": "string"
                    },
                    "itemId": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "active",
                        "expired",
                        "released",
                        "purchased"
                      ]
                    },
                    "expiresAt": {
                      "type": "string"
                    },
                    "extendedAt": {
                      "nullable": true,
                      "type": "string"
                    },
                    "actions": {
                      "type": "object",
                      "properties": {
                        "extend": {
                          "type": "boolean"
                        },
                        "release": {
                          "type": "boolean"
                        },
                        "purchase": {
                          "type": "boolean"
                        }
                      },
                      "required": [
                        "extend",
                        "release",
                        "purchase"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "holdId",
                    "itemId",
                    "status",
                    "expiresAt",
                    "extendedAt",
                    "actions"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "404": {
            "description": "No such list or hold, no valid session for the list, or the hold is not this session's. These are deliberately indistinguishable (ADR-0016, ADR-0054).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "The hold was already released or purchased (hold_not_active), or it expired and no unit is free any more (item_unavailable).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  }
}
