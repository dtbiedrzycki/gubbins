                    "maximum": 9007199254740991
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "message": {
                    "type": "string",
                    "maxLength": 300
                  }
                },
                "required": [
                  "idempotencyKey",
                  "amountMinor",
