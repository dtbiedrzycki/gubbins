#!/usr/bin/env bash
#
# Verify every outgoing commit is signed by a key in .allowed_signers
# before it leaves this clone. Convenience guard — bypassable with
# `git push --no-verify`; CI and pre-receive are the binding gates.
#
# stdin lines: <local ref> <local oid> <remote ref> <remote oid>

set -euo pipefail

root="$(git rev-parse --show-toplevel)"
verify="$root/scripts/verify-signatures.sh"
rc=0

# True for git's all-zero "no such object" id, or an empty field.
is_null() { [ -z "${1:-}" ] || printf '%s' "$1" | grep -Eq '^0+$'; }

while read -r _local_ref local_oid _remote_ref remote_oid; do
  # Pushing a deletion — nothing to verify.
  is_null "$local_oid" && continue

  if is_null "$remote_oid"; then
    range="$local_oid --not --remotes"
  else
    range="$remote_oid..$local_oid"
  fi

  bash "$verify" "$range" || rc=1
done

if [ "$rc" -ne 0 ]; then
  echo "pre-push: aborting — unsigned or untrusted commits in the push." >&2
fi
exit "$rc"
