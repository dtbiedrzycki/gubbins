# Committed defaults for local development. Copy to .env (gitignored) and
# override per-developer as needed — .env layers on top of this file, it
# doesn't replace it.

NODE_ENV=development
PORT=3000
DATABASE_PATH=/workspace/data/wishlist.db

# GitHub CLI auth (ADR-071): a fine-grained personal access token scoped
# to just this repository. Contents (read) covers cloning; add
# Pull requests / Issues (read-write) only if you need `gh` to act on
# them from inside the container. Set the real value in your gitignored
# .env — never here.
GH_TOKEN=

