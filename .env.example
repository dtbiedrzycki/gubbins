# Committed defaults for local development. Copy to .env (gitignored) and
# override per-developer as needed — .env layers on top of this file, it
# doesn't replace it.

NODE_ENV=development
PORT=3000
DATABASE_PATH=/workspace/data/wishlist.db

# GitHub CLI auth (ADR-0071): a fine-grained personal access token scoped
# to just this repository. Contents (read) covers cloning; add
# Pull requests / Issues (read-write) only if you need `gh` to act on
# them from inside the container. Set the real value in your gitignored
# .env — never here.
GH_TOKEN=

# Signs the guest session cookie (HMAC via @fastify/cookie). Generate a
# real value with `openssl rand -base64 32` and set it in your gitignored
# .env. The value is trimmed, so one that is empty or only whitespace counts
# as unset. Outside production the server then falls back to an insecure
# development default (with a startup warning); with NODE_ENV=production it
# refuses to start.
SESSION_COOKIE_SECRET=

# Required: the server refuses to start without it. Creating a list always
# requires this value (ADR-0080). Generate one with `openssl rand -base64 32`
# and set it in your gitignored .env.
CREATE_SECRET=

# Hold length in whole days (ops, ADR-0002). The one self-service extension
# adds the same again, so a hold lasts at most twice this. Empty means 3.
HOLD_DURATION_DAYS=
