# Commit-signing identity for this clone. Copy this file to
#   .devcontainer/secrets/signing.env
# (which is git-ignored) and fill in the two values, then run
#   bash scripts/setup-signing.sh
#
# This file is sourced by the shell, so QUOTE the values — always safe,
# and required if the name contains a space or an apostrophe.
#
# SIGNING_NAME  becomes git user.name and the SSH key comment.
# SIGNING_EMAIL becomes git user.email and the principal recorded in
#               .allowed_signers. Use an address you're willing to have
#               appear in public commit metadata.

SIGNING_NAME="Ada Lovelace"
SIGNING_EMAIL="ada@example.com"
