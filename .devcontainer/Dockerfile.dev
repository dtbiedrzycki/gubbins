# Dev image only — deliberately separate from the minimal, non-root
# production image (see /Dockerfile). This one carries dev tooling and
# matches the host UID/GID instead of a fixed one.
#
# Pinned to a specific Node LTS minor (not a floating "22" or "lts" tag)
# so `npm ci` resolves identically for every contributor.
FROM node:24.17-bookworm-slim

# git/ca-certificates/openssh-client cover npm installs from git refs and
# committing from inside the container; sqlite3 gives a CLI for poking at
# wishlist.db directly during development. python3/make/g++ are a
# node-gyp fallback: better-sqlite3 ships prebuilt binaries for common
# glibc/Node/arch combos, but falls back to compiling from source when no
# exact prebuilt matches (e.g. a brand-new Node minor, or an arch like
# Apple Silicon depending on how Podman is running it) — without a
# toolchain that fallback fails `npm ci` outright instead of just being
# slower.
#
# gnupg is for scripts/verify-signatures.sh, which the git hooks run on
# every commit and push: it checks the PGP-signed merges GitHub makes
# through its web UI against .allowed_pgp_keys.asc. The base image ships
# only gpgv, which can verify against a keyring but cannot import a key.
# It has to be installed here rather than at runtime because the egress
# proxy allowlists no Debian mirror (ADR-068); build-time fetches are not
# subject to that allowlist.
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    ca-certificates \
    openssh-client \
    gnupg \
    sqlite3 \
    python3 \
    make \
    g++ \
    curl \
    iproute2 \
    tmux \
    && rm -rf /var/lib/apt/lists/*

# gh isn't in Debian's default repos — needs its own apt source. This is
# a build-time fetch (github.com/cli.github.com), separate from the
# runtime egress-proxy allowlist discussed elsewhere in this project;
# build-time network isn't subject to that restriction.
RUN curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
        -o /usr/share/keyrings/githubcli-archive-keyring.gpg \
    && chmod go+r /usr/share/keyrings/githubcli-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
        > /etc/apt/sources.list.d/github-cli.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends gh \
    && rm -rf /var/lib/apt/lists/*

# Global npm install rather than npx-per-invocation, so `claude` is on
# PATH immediately in every shell without a first-run download delay.
# Unpinned ("latest") for now — inconsistent with the pinned-everything-
# else philosophy in this file, but Claude Code ships new versions very
# frequently; worth deciding deliberately whether to pin a version here
# once the setup stabilizes, rather than defaulting to it silently.
RUN npm install -g @anthropic-ai/claude-code

# Re-point the existing "node" user's UID/GID at the invoking host user's,
# so files created in the bind-mounted workspace aren't owned by a
# mismatched id on the host (the classic Linux bind-mount permission trap).
# Defaults match a typical single-user Linux desktop if not overridden.
ARG USER_UID=1000
ARG USER_GID=1000
RUN groupmod -g ${USER_GID} node \
    && usermod -u ${USER_UID} -g ${USER_GID} node \
    && find / -xdev -group 1000 -exec chgrp -h ${USER_GID} {} \; 2>/dev/null || true \
    && find / -xdev -user 1000 -exec chown -h ${USER_UID} {} \; 2>/dev/null || true

# `npm install -g` above ran as root, so the Claude Code package tree and
# its bin shim are root-owned. Claude Code's in-app auto-updater re-runs
# `npm install -g` as the non-root `node` user, hits EACCES, and records
# "no_permissions" in ~/.claude/.last-update-result.json — pinning the
# container to the image's build-time version. Hand the npm global tree
# to `node` so updates apply in place. Same idea as the node_modules
# volume chown below; after the usermod re-point so `node` is the final UID.
RUN chown -R node:node /usr/local/lib/node_modules /usr/local/bin

# Playwright's Chromium, baked into the image rather than fetched at
# runtime. Two independent reasons it cannot be a runtime step:
#
#   1. bookworm-slim ships none of Chromium's shared libraries (libnss3,
#      libgbm, libasound2, libatk, libxkbcommon, libpango, libcups...),
#      and pulling them is apt — which needs root. The container runs as
#      `node` with no sudo, so `playwright install --with-deps` can never
#      succeed from inside a running container, sandboxed or not.
#   2. Under the `auto`-mode egress proxy (docker-compose.sandbox.yml),
#      cdn.playwright.dev is not on the allowlist. Baking at build time
#      means that stays true — no ADR-068 allowlist widening needed for
#      what is only ever a development-time dependency.
#
# Build-time network is not subject to the runtime egress allowlist —
# same property the github-cli apt source above already relies on.
#
# PLAYWRIGHT_VERSION MUST match the playwright-core version resolved in
# package-lock.json: Playwright refuses a browser build it didn't pin
# ("Executable doesn't exist at ..."), so drift fails loudly at test
# time rather than silently. Bump both together, then rebuild the image.
ARG PLAYWRIGHT_VERSION=1.63.0

# Default is ~/.cache/ms-playwright. Pointed at a fixed system path
# instead so the binary lives in the image layer rather than in $HOME,
# which the devcontainer flow may mount over.
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
RUN npx --yes playwright@${PLAYWRIGHT_VERSION} install --with-deps chromium \
    && rm -rf /var/lib/apt/lists/* \
    && chown -R node:node /ms-playwright

# C.UTF-8 needs no locale-gen or the `locales` package — Debian's glibc
# ships it built in. Without a UTF-8 locale, bookworm-slim defaults to
# LANG unset/POSIX, and any TUI using UTF-8 box-drawing or spinner
# glyphs (Claude Code's included) renders garbled rather than cleanly
# falling back to ASCII.
ENV LANG=C.UTF-8
ENV LC_ALL=C.UTF-8

# Truecolor: many TUIs (Claude Code included) decide whether to emit
# 24-bit colour from $COLORTERM rather than terminfo. tmux does not
# forward COLORTERM from the outer environment, and the tmux-256color
# terminfo entry carries no RGB capability, so without this the app
# inside tmux falls back to a low-contrast 256-colour approximation of
# its theme. Pairs with the terminal-features/-overrides lines in
# .tmux.conf below.
ENV COLORTERM=truecolor

# Correct terminal capability reporting inside tmux — the other common
# cause of the same garbled-character symptom, via mishandled
# escape/cursor sequences rather than encoding. See file for detail.
COPY --chown=node:node .devcontainer/.tmux.conf /home/node/.tmux.conf

# node-gyp's own fallback (see the python3/make/g++ comment above) is to
# download matching Node headers from nodejs.org — fine in a normal
# session, but unreachable for an `auto`-mode session behind the
# egress-proxy allowlist (ADR-068: npm registry, GitHub, Anthropic API
# only). This image's `node:24.17-bookworm-slim` base already unpacks
# Node's own headers under /usr/local/include/node, matching the exact
# running Node build byte-for-byte, so pointing node-gyp there directly
# skips the network fetch entirely — for every session, sandboxed or
# not, since the headers are always right for this pinned image.
# npm reads any npm_config_<key> env var, so no .npmrc is needed; this
# must NOT live in a repo-root .npmrc, which would also apply on CI
# runners (a different Node install path, with full internet access and
# no need for the override in the first place).
ENV npm_config_nodedir=/usr/local

# The node_modules named volume (docker-compose.yml) is provisioned empty
# by the Docker daemon as root:root. Docker seeds a fresh volume's root
# — contents AND ownership — from the image's mount point, so creating it
# here owned by node is what lets `npm ci` write to it as the non-root
# user. Without this line every clean `up` gets a root-owned node_modules
# and the first install fails with EACCES.
RUN mkdir -p /workspace/node_modules && chown node:node /workspace/node_modules

# Sync node_modules with the lockfile on every start, for both the plain
# `docker compose up` path and the Dev Containers flow (see the script).
# The source file is committed executable, so COPY carries 0755 across.
COPY --chown=node:node .devcontainer/dev-entrypoint.sh /usr/local/bin/dev-entrypoint

USER node
WORKDIR /workspace

ENTRYPOINT ["/usr/local/bin/dev-entrypoint"]
